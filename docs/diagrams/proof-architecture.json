  "cards": [
    {
      "dot": "cyan",
      "title": "Why four services, not one agent",
      "items": [
        "Coordinator chooses among 4 tools; each sub-agent among 4–6.",
        "Nobody discriminates between 21 similarly named tools.",
        "Demand cannot read line state — its session has no such tool."
      ]
    },
    {
      "dot": "emerald",
      "title": "Authorization lives in Postgres",
      "items": [
        "agent_read holds SELECT and nothing else.",
        "A prompt-injected agent still cannot write to a plant table.",
        "Writes arrive in Phase 4 as a separate role and approval queue."
      ]
    },
    {
      "dot": "violet",
      "title": "Every number carries its lineage",
      "items": [
        "Each tool returns rows plus the SQL that produced them.",
        "Procedural claims must cite a retrieved SOP section.",
        "A fabricated citation replaces the answer rather than annotating it."
      ]
    }
  ]
