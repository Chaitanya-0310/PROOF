# Copy to .env and adjust. .env is gitignored (never commit real secrets).
# In a real deployment these come from a secrets manager, not a file.

# --- Superuser (bootstrap only: creates schemas + least-privilege roles) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_DB=proof
POSTGRES_PORT=5434

# --- Least-privilege role passwords ---
# Every component connects as its OWN role. See db/init/03_roles.sql.
#   seeder      -> writes synthetic plant data (Phase 1 only)
#   agent_read  -> read-only; this is what the MCP servers use (Phase 2+)
#   action_rw   -> may write ONLY to the action queue, never to plant tables (Phase 4)
SEEDER_PASSWORD=seeder_pw
AGENT_READ_PASSWORD=agentread_pw
ACTION_RW_PASSWORD=actionrw_pw

# --- Connection defaults used by Python code ---
# PGHOST/PGPORT are overridden to db:5432 inside docker-compose.
PGHOST=localhost
PGPORT=5434
PGDATABASE=proof

# --- Phase 4: the human approval role ---
# Separate login because it is the ONLY role permitted to set an action's
# status. The agent's role structurally cannot approve its own proposal.
APPROVER_PASSWORD=approver_pw

# --- Phase 2+: the model (required to run the agent / demos / live eval) ---
# The ONLY external credential the system needs. The tool, MCP, retrieval,
# authz and trace layers all run without it -- see the `make smoke*` targets.
ANTHROPIC_API_KEY=

# --- Optional: a non-Anthropic model behind a Messages-API-compatible gateway ---
# Setting ANTHROPIC_BASE_URL (host only -- the SDK appends /v1/messages) also
# switches off the Claude-only request features (adaptive thinking, fallback).
# Put the gateway's key in ANTHROPIC_API_KEY above; if it expects a Bearer
# token instead, use ANTHROPIC_AUTH_TOKEN. Set the model ids it lists, and its
# per-million-token prices so cost lines and the session budget are right.
# ANTHROPIC_BASE_URL=https://api.example.com
# PROOF_COORDINATOR_MODEL=
# PROOF_SUBAGENT_MODEL=
# PROOF_USD_PER_MTOK_IN=
# PROOF_USD_PER_MTOK_OUT=
# PROOF_MAX_TOKENS=8000

# --- Phase 5: Langfuse tracing (OPTIONAL) ---
# Leave blank to trace only to data/traces/*.jsonl. Set both keys to also
# export spans to Langfuse over OTLP (cloud or self-hosted -- only HOST differs).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Model routing (OPTIONAL; off by default) ---
# off   = one fixed model everywhere (behaviour without a router)
# light = always PROOF_ROUTER_LIGHT_MODEL (benchmark control arm)
# jev   = TypeSafe Jev picks light/strong per decision via OpenRouter's
#         Decisions API. Only the question text, role and domain charter are
#         sent to it -- never tool results or plant data.
# Any router error, missing key, or confidence below the threshold routes to
# the STRONG tier (= the configured model), never to the light one.
# PROOF_ROUTER=off
# PROOF_ROUTER_SCOPE=all                     # all | subagents
# PROOF_ROUTER_LIGHT_MODEL=deepseek-v4-flash-0731
# PROOF_ROUTER_STRONG_MODEL=                 # blank = PROOF_*_MODEL above
# PROOF_ROUTER_MIN_CONFIDENCE=0.6
# PROOF_JEV_MODEL=typesafe/jev-1.13
# OPENROUTER_API_KEY=
# Per-model prices once more than one model is in play, USD per MTok [in, out]:
# PROOF_MODEL_PRICES={"gpt-5.6-luna": [0.046, 0.092], "deepseek-v4-flash-0731": [0, 0]}
